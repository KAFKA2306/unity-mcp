{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/unity-mcp/blob/beta/website/data/failures/source-schema.json",
  "title": "FailureSource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "canonical_url",
    "fetch_url",
    "source_family",
    "source_class",
    "content_type",
    "fetch_mode",
    "enabled",
    "year_scope",
    "languages",
    "repository",
    "last_verified_date",
    "access_note"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "fetch_url": {"type": "string", "format": "uri"},
    "source_family": {"type": "string", "minLength": 1},
    "source_class": {"type": "string", "enum": ["official", "maintainer", "community", "article"]},
    "content_type": {"type": "string", "enum": ["docs", "release", "issues", "commits", "issue_tracker", "forum", "article"]},
    "fetch_mode": {"type": "string", "enum": ["github_api", "html", "rss", "sitemap", "manual_url"]},
    "enabled": {"type": "boolean"},
    "year_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["2026"]}},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "repository": {"type": "string", "minLength": 1},
    "last_verified_date": {"type": "string", "format": "date"},
    "access_note": {"type": "string", "minLength": 1}
  }
}
