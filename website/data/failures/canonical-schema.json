{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/unity-mcp/blob/beta/website/data/failures/canonical-schema.json",
  "title": "CanonicalFailureRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "date",
    "date_kind",
    "evidence",
    "environment",
    "classification",
    "symptom"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "date_kind": {"type": "string", "enum": ["published", "observed"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "source_type", "publisher", "supports"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "source_type": {
            "type": "string",
            "enum": ["official_release", "github_issue", "article", "forum", "unity_issue_tracker"]
          },
          "publisher": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "format": "date"},
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["title", "date", "environment", "error_signature", "symptom", "trigger", "root_cause", "remedies"]
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unity_version", "packages"],
      "properties": {
        "unity_version": {"type": "string", "const": "2022.3.22f1"},
        "vrchat_sdk_version": {"type": "string", "minLength": 1},
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "host_os": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "enum": ["Windows", "macOS", "Linux"]},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "target_platform": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["Windows", "Android", "iOS"]}
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software", "component", "phase", "failure_type"],
      "properties": {
        "software": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "failure_type": {"type": "string", "minLength": 1}
      }
    },
    "error_signature": {"type": "string", "minLength": 1},
    "symptom": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "remedies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description"],
        "properties": {
          "type": {"type": "string", "enum": ["fix", "workaround"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
