{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/unity-mcp/blob/beta/website/data/failures/schema.json",
  "title": "FailureRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "date",
    "date_kind",
    "source_urls",
    "source_type",
    "source_family",
    "component",
    "unity_version",
    "vrcsdk_version",
    "packages",
    "platforms",
    "stage",
    "error_signature",
    "symptom",
    "trigger",
    "root_cause",
    "solution",
    "workaround",
    "status",
    "tags"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^2026-[0-9]{2}-[0-9]{2}$", "format": "date"},
    "date_kind": {"type": "string", "enum": ["published", "observed"]},
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uri"}
    },
    "source_type": {
      "type": "string",
      "enum": ["official_release", "github_issue", "article", "forum", "unity_issue_tracker"]
    },
    "source_family": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "source_type", "publisher", "supports"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "source_type": {
            "type": "string",
            "enum": ["official_release", "github_issue", "article", "forum", "unity_issue_tracker"]
          },
          "publisher": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "format": "date"},
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "title",
                "date",
                "environment",
                "error_signature",
                "symptom",
                "trigger",
                "root_cause",
                "solution",
                "workaround",
                "fixed_in"
              ]
            }
          }
        }
      }
    },
    "component": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unity_version"],
      "properties": {
        "unity_version": {"type": "string", "minLength": 1},
        "vrchat_sdk_version": {"type": "string", "minLength": 1},
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "host_os": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "enum": ["Windows", "macOS", "Linux"]},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "target_platform": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["Windows", "Android", "iOS"]}
        }
      }
    },
    "unity_version": {"type": "string", "minLength": 1},
    "vrcsdk_version": {"type": "string", "minLength": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "stage": {"type": "string", "minLength": 1},
    "error_signature": {"type": "string", "minLength": 1},
    "symptom": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "solution": {"type": "string", "minLength": 1},
    "workaround": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["resolved", "workaround", "unresolved", "unknown"]},
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    }
  }
}
